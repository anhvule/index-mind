# Copy to backend/.env to override defaults. All values are optional.
# The desktop app sets the two folders itself; these matter when running the backend alone.
INDEXMIND_DOCS_DIR=../documents
INDEXMIND_DATA_DIR=.indexmind

INDEXMIND_OLLAMA_URL=http://127.0.0.1:11434
INDEXMIND_CHAT_MODEL=llama3.2
INDEXMIND_EMBED_MODEL=nomic-embed-text

INDEXMIND_CHUNK_SIZE=1000
INDEXMIND_CHUNK_OVERLAP=150
INDEXMIND_TOP_K=6
INDEXMIND_MIN_SIMILARITY=0.3
